# Copy this file to .env. Never commit .env.

# Option A: Gemini or Groq (both have a free tier)
ECO_LLM_PROVIDER=gemini
ECO_LLM_API_KEY=

# Option B: Claude
ANTHROPIC_API_KEY=

# Optional
ECO_LLM_MODEL=
ECO_LLM_BASE_URL=
ECO_TOKEN=
ECO_ASK_PER_MIN=10
ECO_ASK_PER_DAY=300

# Leave empty to use the embedded database
FALKORDB_HOST=
FALKORDB_PORT=6379
