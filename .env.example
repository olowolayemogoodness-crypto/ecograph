# Copy to .env (never commit .env). Model keys live on the server only, never in the app.
# Switch the Ask agent on with ONE of these two:

# A) Claude (Anthropic API)
ANTHROPIC_API_KEY=
ECO_MODEL=claude-sonnet-5-5

# B) Any OpenAI-compatible provider. Gemini and Groq both have a free tier (no card needed):
#    gemini -> key from https://aistudio.google.com/apikey      groq -> key from https://console.groq.com/keys
ECO_LLM_PROVIDER=gemini      # gemini | groq | openrouter
ECO_LLM_API_KEY=
ECO_LLM_MODEL=               # optional: defaults to gemini-3.8-flash (gemini) or llama-3.3-70b-versatile (groq)
ECO_LLM_BASE_URL=            # optional: only for a provider that has no preset
# ECO_LLM_MAX_TOKENS=          # optional: output cap per model call (default 8192 for gemini, 1500 otherwise)

# Optional protection: the app sends this as "Authorization: Bearer <token>". Leave empty for a public synthetic-data demo.
ECO_TOKEN=
ECO_ASK_PER_MIN=10
ECO_ASK_PER_DAY=300

# Leave FALKORDB_HOST empty to use the embedded database; docker compose sets it for you.
FALKORDB_HOST=
FALKORDB_PORT=6379
